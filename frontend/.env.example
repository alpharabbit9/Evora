# CommerceCore frontend — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values reach the browser; never put a secret here.

# Base URL of the Express API (backend/). Must match the backend's FRONTEND_ORIGIN pairing.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The storefront's own public origin, for canonical links, Open Graph images, robots.txt, the
# sitemap and JSON-LD. Optional in development (defaults to http://localhost:3000); set it in
# every build that is crawled or shared.
# NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Origin + path product images are served from. Must match the backend's MEDIA_PUBLIC_URL.
# Optional: defaults to NEXT_PUBLIC_API_URL + /media (the API's development media route).
# NEXT_PUBLIC_MEDIA_URL=https://cdn.example.com/media

# Optional, staging reviews only: set to true to show sample reviews and answers or promises that
# wait on a decided policy in a production build (ADR 0026). Development always shows them. Never
# set it for the live store.
# NEXT_PUBLIC_SHOW_UNCONFIRMED_CONTENT=true

# Optional kill switch (plan.md Phase 6, ADR 0027 §7): the WebGL layer over the home page's
# Recent Arrivals rail is on by default for mouse users with WebGL2 and without reduced motion.
# Set to false to ship the CSS rail only. `?rail=3d` / `?rail=css` override it per page load.
# NEXT_PUBLIC_RAIL_3D=false

# Server-only, optional: where the Next.js server reaches the API over a private network
# (e.g. http://api:4000 in a container network). Unset, it uses NEXT_PUBLIC_API_URL. ADR 0024.
# API_INTERNAL_URL=
