# CommerceCore frontend — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values reach the browser; never put a secret here.

# Base URL of the Express API (backend/). Must match the backend's FRONTEND_ORIGIN pairing.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origin + path product images are served from. Must match the backend's MEDIA_PUBLIC_URL.
# Optional: defaults to NEXT_PUBLIC_API_URL + /media (the API's development media route).
# NEXT_PUBLIC_MEDIA_URL=https://cdn.example.com/media
