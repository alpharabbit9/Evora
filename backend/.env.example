# CommerceCore backend — copy to .env and fill in. Never commit a real .env.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# Prisma 7 reads this in prisma.config.ts (migrate) and via @prisma/adapter-pg (runtime).
# The user:password below is a PLACEHOLDER and will not authenticate against your server.
# Create the database and a role that owns it, then put the real credentials here:
#   psql -U postgres -c "CREATE ROLE commercecore LOGIN PASSWORD '<choose-one>';"
#   psql -U postgres -c "CREATE DATABASE commercecore OWNER commercecore;"
#   npm run prisma:deploy     # applies prisma/migrations to it
DATABASE_URL=postgresql://commercecore:replace-with-your-db-password@localhost:5432/commercecore?schema=public

# --- Better Auth ---
# Signs session cookies and verification/reset tokens. MUST be replaced: env validation
# rejects any value that still looks like a placeholder, so a fresh clone cannot boot with a
# publicly known signing secret.
#
# Generate one (any of these):
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   npx @better-auth/cli secret
#
# Rotating it invalidates every existing session, which is the intended effect after a leak.
# In production this belongs in the host's secret manager, never in a file on disk.
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret

# The API's own canonical URL. Better Auth builds verification/reset links from it and trusts
# its origin, so it must be the externally reachable address (https in production), not a
# container-internal one.
BETTER_AUTH_URL=http://localhost:4000

# --- Frontend origin (CORS + cookie/redirect allow-list) ---
# In development the frontend and API are cross-ORIGIN but same-SITE (ports are ignored when
# deciding "site"), so the SameSite=Lax session cookie is sent. Do NOT mix localhost with
# 127.0.0.1 between the two: those are different sites and sign-in will silently fail.
FRONTEND_ORIGIN=http://localhost:3000

# --- Object storage for product images (src/lib/storage.ts) ---
# filesystem: writes under MEDIA_ROOT (relative to backend/). Development only — env
#             validation refuses it with NODE_ENV=production.
# s3:         any S3-compatible store (AWS S3 / R2 / MinIO); needs the S3_* values below.
STORAGE_DRIVER=filesystem
MEDIA_ROOT=.data/media
# Public base URL that image keys are appended to in API responses. Optional with the filesystem
# driver (defaults to BETTER_AUTH_URL + /media, served by the API); REQUIRED with s3 (the bucket's
# public or CDN origin). The frontend's NEXT_PUBLIC_MEDIA_URL must name the same origin and path.
# MEDIA_PUBLIC_URL=https://cdn.example.com/media

# S3-compatible settings. Provider still undecided.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=commercecore-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Integration tests (npm run test:db, npm run test:integration) ---
# A SEPARATE database: both suites truncate every table, and tests/db/client.ts refuses to
# run if this equals DATABASE_URL. Create it the same way, then apply migrations with
#   DATABASE_URL=<this value> npm run prisma:deploy
# Leave blank to skip the database suites; `npm test` does not need it.
DATABASE_URL_TEST=postgresql://commercecore:replace-with-your-db-password@localhost:5432/commercecore_test?schema=public

# --- Development seed (npm run prisma:seed) ---
# Optional. Without SEED_ADMIN_PASSWORD no account is created — there is no default password.
# The seed never overwrites existing stock, price or publication status on a rerun.
#
# This account is seeded as SUPERADMIN: granting a role is a superadmin-only operation, so
# it is the bootstrap from which every other administrator is promoted through
# PATCH /api/v1/admin/customers/:userId/role. Must satisfy the 12-character minimum.
SEED_ADMIN_EMAIL=admin@commercecore.test
SEED_ADMIN_NAME=CommerceCore Admin
SEED_ADMIN_PASSWORD=
# Guard rail: the seed refuses to run with NODE_ENV=production unless this is exactly "true".
SEED_ALLOW_PRODUCTION=

# --- Store currency (ADR 0008 amendment: BDT) ---
# Read by tooling that writes prices; currently only the catalog importer's --demo-pricing.
STORE_CURRENCY=BDT

# --- Catalog importer (npm run catalog:import; docs/fashion-catalog-setup.md) ---
# Kaggle API token from https://www.kaggle.com/settings -> "Create New Token". The importer
# uses only these two values — never put your Kaggle account password in this file.
# Without them, only files already under CATALOG_DATA_DIR are used.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Download cache and import reports (gitignored).
CATALOG_DATA_DIR=.data/catalog

# --- Not yet selected (see docs/PRD.md §9) ---
# Payment provider keys: pending ADR. Do not add live keys.
#
# Email provider keys: pending ADR. Until one is chosen there is NO email delivery:
# password-reset and email-verification requests succeed and queue a row in `outbox_events`,
# and nothing sends it. `emailAndPassword.requireEmailVerification` is therefore false in
# src/lib/auth.ts and must stay false until a provider and the M9 outbox worker exist.
