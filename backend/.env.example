# CommerceCore backend — copy to .env and fill in. Never commit a real .env.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# Prisma 7 reads this in prisma.config.ts (migrate) and via @prisma/adapter-pg (runtime).
# The user:password below is a PLACEHOLDER and will not authenticate against your server.
# Create the database and a role that owns it, then put the real credentials here:
#   psql -U postgres -c "CREATE ROLE commercecore LOGIN PASSWORD '<choose-one>';"
#   psql -U postgres -c "CREATE DATABASE commercecore OWNER commercecore;"
#   npm run prisma:deploy     # applies prisma/migrations to it
DATABASE_URL=postgresql://commercecore:replace-with-your-db-password@localhost:5432/commercecore?schema=public

# --- Better Auth ---
# Signs session cookies and verification/reset tokens. MUST be replaced: env validation
# rejects any value that still looks like a placeholder, so a fresh clone cannot boot with a
# publicly known signing secret.
#
# Generate one (any of these):
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   npx @better-auth/cli secret
#
# Rotating it invalidates every existing session, which is the intended effect after a leak.
# In production this belongs in the host's secret manager, never in a file on disk.
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret

# The API's own canonical URL. Better Auth builds verification/reset links from it and trusts
# its origin, so it must be the externally reachable address (https in production), not a
# container-internal one.
BETTER_AUTH_URL=http://localhost:4000

# --- Frontend origin (CORS + cookie/redirect allow-list) ---
# In development the frontend and API are cross-ORIGIN but same-SITE (ports are ignored when
# deciding "site"), so the SameSite=Lax session cookie is sent. Do NOT mix localhost with
# 127.0.0.1 between the two: those are different sites and sign-in will silently fail.
FRONTEND_ORIGIN=http://localhost:3000

# Production must be same-site (ADR 0024): serve the API under the storefront's host (path /api,
# preferred; leave this unset) or on a sibling subdomain and set the shared parent domain here,
# e.g. example.com for shop.example.com + api.example.com. The API refuses to start otherwise.
AUTH_COOKIE_DOMAIN=

# --- Object storage for product images (src/lib/storage.ts) ---
# filesystem: writes under MEDIA_ROOT (relative to backend/). Development only — env
#             validation refuses it with NODE_ENV=production.
# s3:         any S3-compatible store (AWS S3 / R2 / MinIO); needs the S3_* values below.
STORAGE_DRIVER=filesystem
MEDIA_ROOT=.data/media
# Public base URL that image keys are appended to in API responses. Optional with the filesystem
# driver (defaults to BETTER_AUTH_URL + /media, served by the API); REQUIRED with s3 (the bucket's
# public or CDN origin). The frontend's NEXT_PUBLIC_MEDIA_URL must name the same origin and path.
# MEDIA_PUBLIC_URL=https://cdn.example.com/media

# S3-compatible settings. Provider still undecided.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=commercecore-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Integration tests (npm run test:db, npm run test:integration) ---
# A SEPARATE database: both suites truncate every table, and tests/db/client.ts refuses to
# run if this equals DATABASE_URL. Create it the same way, then apply migrations with
#   DATABASE_URL=<this value> npm run prisma:deploy
# Leave blank to skip the database suites; `npm test` does not need it.
DATABASE_URL_TEST=postgresql://commercecore:replace-with-your-db-password@localhost:5432/commercecore_test?schema=public

# --- Development seed (npm run prisma:seed) ---
# Optional. Without SEED_ADMIN_PASSWORD no account is created — there is no default password.
# The seed never overwrites existing stock, price or publication status on a rerun.
#
# This account is seeded as SUPERADMIN: granting a role is a superadmin-only operation, so
# it is the bootstrap from which every other administrator is promoted through
# PATCH /api/v1/admin/customers/:userId/role. Must satisfy the 12-character minimum.
SEED_ADMIN_EMAIL=admin@commercecore.test
SEED_ADMIN_NAME=CommerceCore Admin
SEED_ADMIN_PASSWORD=
# Guard rail: the seed refuses to run with NODE_ENV=production unless this is exactly "true".
SEED_ALLOW_PRODUCTION=

# --- Store currency (ADR 0008 amendment: BDT) ---
# Read by tooling that writes prices; currently only the catalog importer's --demo-pricing.
STORE_CURRENCY=BDT

# --- Catalog importer (npm run catalog:import; docs/fashion-catalog-setup.md) ---
# Kaggle API token from https://www.kaggle.com/settings -> "Create New Token". The importer
# uses only these two values — never put your Kaggle account password in this file.
# Without them, only files already under CATALOG_DATA_DIR are used.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Download cache and import reports (gitignored).
CATALOG_DATA_DIR=.data/catalog

# --- Online payment: SSLCOMMERZ sandbox (ADR 0019) ---
# Leave the store id and password blank and the store offers cash on delivery only.
# Sandbox credentials: register a free store at https://developer.sslcommerz.com/registration/
# Live credentials and the live host are refused until PRD §8's launch gates are met.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
# Public address of this API for the provider's notifications. Defaults to BETTER_AUTH_URL, which
# the provider cannot reach on localhost; payments then settle through the browser return and
# `npm run payments:reconcile`. Set a tunnel URL here to receive notifications in development.
# PAYMENT_CALLBACK_BASE_URL=https://your-tunnel.example.com
#
# To try checkout with no account at all, run `npm run payments:fake-gateway` and follow what it prints.

# --- Email and the background worker (ADR 0021; npm run worker) ---
# filesystem: writes each message as an .eml file under MAIL_ROOT and sends NOTHING. Development
#             only — env validation refuses it with NODE_ENV=production.
# smtp:       any SMTP relay. No provider is chosen yet (docs/PRD.md §9); every candidate speaks
#             SMTP. For a local inbox, run Mailpit and use SMTP_HOST=localhost SMTP_PORT=1025.
EMAIL_DRIVER=filesystem
MAIL_ROOT=.data/mail
# Required to be a real sending domain in production (SPF/DKIM/DMARC configured for it).
EMAIL_FROM="CommerceCore <no-reply@commercecore.localhost>"
STORE_NAME=CommerceCore
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). Otherwise production requires STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Low-stock and payment-review alerts, comma-separated. Blank: every active administrator.
STAFF_ALERT_EMAILS=
# Worker tuning; the defaults suit one small store.
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
# How often the payment and refund sweep runs (min 60000).
RECONCILE_INTERVAL_MS=300000
#
# Password-reset and verification links are delivered by the worker. `requireEmailVerification`
# stays false in src/lib/auth.ts until a relay is configured and the storefront has a
# "check your inbox" step.

# --- Shopping assistant (ADR 0025; docs/assistant-setup.md) ---
# Groq answers; OpenAI, if set, makes embeddings and answers when Groq cannot. Groq alone works:
# leave the OPENAI_* keys blank for full-text policy search and no fallback. With no chat provider
# at all the assistant is not offered (the widget stays hidden). Real keys go in backend/.env only.
# Pick a Groq model that supports tool use, e.g. openai/gpt-oss-120b
# (https://console.groq.com/docs/models).
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# The vector columns are vector(1536); a different embedding model needs a migration.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
# Daily caps: tokens per signed-in customer, messages per guest (by hashed IP).
ASSISTANT_DAILY_TOKEN_BUDGET=60000
ASSISTANT_GUEST_DAILY_MESSAGES=20
# How often the worker refreshes the assistant's search index (min 60000).
ASSISTANT_INDEX_INTERVAL_MS=900000
#
# To try it with no accounts, run `npm run assistant:fake-llm` and follow what it prints.

# --- Serverless hosting: Vercel (ADR 0028; docs/runbooks/vercel.md) ---
# Not needed for local development. On Vercel these go in the project's Environment Variables
# (Production), never in a file. The full list, with what to set each one to, is in the runbook.
#
# Vercel runs no worker process. The outbox is drained by a schedule calling
#   GET /api/v1/internal/outbox/drain   with   Authorization: Bearer <CRON_SECRET>
# (Vercel Cron sends exactly that) and by the API right after each successful write.
# Required on Vercel; leave blank locally, where `npm run worker:dev` drains the outbox.
CRON_SECRET=
# Drain the outbox after each successful write. Default: true on Vercel, false elsewhere.
# OUTBOX_DRAIN_AFTER_WRITES=
# Shared with the storefront's API_PROXY_SECRET when the storefront forwards /api here, so rate
# limits count each visitor instead of the storefront's own address. 32+ characters.
API_PROXY_SECRET=
# Build-time only, for `prisma migrate deploy` in `npm run vercel-build`: a DIRECT (non-pooled)
# connection to the same database as DATABASE_URL. Neon calls it DATABASE_URL_UNPOOLED.
# DIRECT_DATABASE_URL=
# Set to true to skip the migration step on a production build.
# SKIP_DB_MIGRATIONS=
